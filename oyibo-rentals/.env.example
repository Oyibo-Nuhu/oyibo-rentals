# Copy this file to .env for local runs, or add these as environment variables on your host.

# Database. Leave unset to use a local SQLite file (oyibo_rentals.db).
# On Render this is filled in automatically from the Postgres database.
# DATABASE_URL=postgresql://user:password@host:5432/oyibo

# Security. Use a long random string in production (Render generates one for you).
JWT_SECRET=change-me-to-a-long-random-string
JWT_HOURS=12

# First admin account, created on first start. Change the password!
ADMIN_EMAIL=admin@oyibo.ng
ADMIN_PASSWORD=ChangeMe123!

# Payments. Leave empty for demo checkout (no real money).
# Use sk_test_... from your Paystack dashboard to test, sk_live_... to go live.
PAYSTACK_SECRET_KEY=
# The public address of your site (Paystack sends customers back here).
PUBLIC_URL=http://localhost:8000

# Demo data: 90 synthetic customers and ~900 rentals so the dashboard has something to show.
# Set to false on a fresh database before going live.
SEED_DEMO_DATA=true
# Simulated GPS movement for active rentals (until real trackers or a driver app send pings).
RUN_TRACKING_SIMULATOR=true

# Map tiles. OpenStreetMap's free server is fine for a demo; for real traffic use a provider
# such as MapTiler or Stadia Maps and paste the tile URL with your key.
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# Where vehicle photos are stored. Point this at a persistent disk in production if admins upload photos.
# PHOTO_DIR=/var/data/photos

# Where customers' driver's licence photos are stored. They are private (admins only, never served
# as public files). Use a persistent disk in production, outside the website folder.
# LICENCE_DIR=/var/data/licences

# Only needed if the frontend is hosted on a different domain from the API.
# CORS_ORIGINS=https://your-frontend.example.com
